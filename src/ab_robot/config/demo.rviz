Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 235; 238; 242
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 30
      Cell Size: 0.5
      Color: 180; 180; 180
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Alpha: 0.65
      Color Scheme: map
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.025
      Color Transformer: FlatColor
      Color: 220; 45; 45
    - Class: rviz_default_plugins/PointCloud2
      Name: Depth
      Enabled: true
      Topic:
        Value: /depth/points
        Reliability Policy: Best Effort
      Size (m): 0.025
      Color Transformer: FlatColor
      Color: 30; 140; 220
    - Class: rviz_default_plugins/Path
      Name: Global path
      Enabled: true
      Topic:
        Value: /plan
      Color: 30; 180; 60
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz_default_plugins/Path
      Name: Local path
      Enabled: true
      Topic:
        Value: /local_plan
      Color: 230; 150; 20
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 42
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 800
  Height: 700
